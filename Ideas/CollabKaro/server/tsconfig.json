{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/app.ts",
    "src/app.test.ts",
    "src/campaigns.ts",
    "src/store.ts"
  ]
}