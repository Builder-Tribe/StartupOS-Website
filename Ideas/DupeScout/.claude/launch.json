{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dupescout-web",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "cd dupescout && npm run dev"],
      "port": 3000
    },
    {
      "name": "dupescout-api",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "cd dupescout && .venv/bin/uvicorn api.main:app --reload --port 8000"],
      "port": 8000
    }
  ]
}
